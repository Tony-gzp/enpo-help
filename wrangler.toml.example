# ============================================================================
# wrangler.toml.example —— 进阶用法的配置模板（默认不生效）
# ----------------------------------------------------------------------------
# 【重要】这个文件叫 .example，Cloudflare 不会读它，所以你什么都不用做。
#
# 为什么默认不启用？
#   本站的推荐上线方式是在 Cloudflare 网页后台点几下完成配置（数据库绑定、
#   环境变量都在网页上设置），完全不需要命令行。详见仓库里的「部署教程.md」。
#
# 如果你更喜欢用命令行的 wrangler 管理，可以：
#   1. 把本文件改名为 wrangler.toml
#   2. 执行 npx wrangler d1 create enpo，把输出的 database_id 填到下面
#   3. 执行 npx wrangler d1 execute enpo --remote --file=./api/schema.sql 建表
#      （其实不建也行：后端第一次收到请求会自动建表并导入初始数据）
# ============================================================================

# name = "enpo-help"
#
# # 这个项目没有构建步骤，直接把仓库根目录当作网站目录发布
# pages_build_output_dir = "."
#
# compatibility_date = "2026-01-01"
#
# # ---------------------------------------------------------------------------
# # D1 数据库绑定：后端代码里通过 env.DB 使用
# # 把 database_id 换成你自己创建出来的那个
# # ---------------------------------------------------------------------------
# [[d1_databases]]
# binding = "DB"
# database_name = "enpo"
# database_id = "在这里填入你在 Cloudflare 后台创建的 D1 数据库 ID"
#
# # ---------------------------------------------------------------------------
# # 环境变量（也可以直接在网页后台的 Settings → Variables and secrets 里配）
# # 口令不要写进这个文件，请配置成加密变量
# # ---------------------------------------------------------------------------
# [vars]
# ADMIN_SESSION_HOURS = "12"        # 登录状态保持多少小时
# ADMIN_MAX_ATTEMPTS = "5"          # 连续输错几次锁定
# ADMIN_LOCK_MINUTES = "10"         # 锁定时长（分钟）
# # 注意：校园网常常整个校区共用一个出口 IP，这几个上限不要设得太小，
# # 否则会误伤同学。下面给的是比较宽松的推荐值。
# RATE_BOOK_PER_HOUR = "30"         # 同一 IP 每小时最多提交几条出书信息
# RATE_SUGGEST_PER_HOUR = "20"      # 同一 IP 每小时最多提交几条建议
# RATE_LOOKUP_PER_HOUR = "200"      # 同一 IP 每小时最多查询几次编辑码
